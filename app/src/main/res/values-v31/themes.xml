<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) splash-screen attributes. They only exist on API 31+, so
  they cannot sit in values/themes.xml without failing the build.

  Each style here re-declares a name from values/themes.xml, and a re-declared
  style replaces its twin rather than merging with it. That is why both parent
  off ThemeCore.*, which has no v31 twin: the shared attributes come down the
  parent chain, and only the splash attributes are added here. Listing them
  again in this file instead would mean two copies drifting apart.

  windowSplashScreenAnimatedIcon MUST resolve to an AdaptiveIconDrawable on
  API 31+. A flat PNG makes the OS silently fall back to the launcher icon, and
  when that cannot be rendered either the stand-in is the generic Android
  figure — the one-second robot flash. ic_splash_logo is the same adaptive icon
  the launcher uses, so the splash and the home-screen icon agree.
-->
<resources>

    <style name="Theme.TrainSprint" parent="ThemeCore.TrainSprint">
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_bg</item>
    </style>

    <style name="Theme.App" parent="ThemeCore.App">
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_bg</item>
    </style>

</resources>
