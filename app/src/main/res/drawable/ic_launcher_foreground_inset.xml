<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground layer for the adaptive launcher icon.
  The inset is expressed in dp against the 108 dp adaptive-icon canvas:
    15 dp / 108 dp ≈ 14 %  — safe starting value.
  If the icon looks clipped under circle/squircle masks → raise to 18-19 dp.
  If it looks too small → lower to 11-12 dp.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@mipmap/ic_launcher_foreground"
        android:left="15dp"
        android:top="15dp"
        android:right="15dp"
        android:bottom="15dp" />
</layer-list>
