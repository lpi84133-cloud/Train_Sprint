<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF5C3E10" />
            <stroke android:width="3dp" android:color="@color/gold_light" />
        </shape>
    </item>
    <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="70%"
                android:startColor="@color/gold"
                android:centerColor="@color/gold_dark"
                android:endColor="#FF5C3E10" />
            <stroke android:width="2dp" android:color="#FF7A5518" />
        </shape>
    </item>
</layer-list>
