<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ splash screen icon (windowSplashScreenAnimatedIcon).
  Must be AdaptiveIconDrawable — flat PNG is silently ignored on API 31+.
  Identical to the launcher icon so the desktop icon and splash match exactly.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launch_bg" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_inset" />
</adaptive-icon>
