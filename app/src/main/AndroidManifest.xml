<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:name=".ledger.RailApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup,android:fullBackupContent,android:dataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${grayAppLabel}"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.App"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Firebase: monochrome notification icon + default channel. Channel id
             is per-project and comes from gray.properties → BuildConfig →
             the manifest placeholder below. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notif_flame" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="${grayFcmChannelId}" />

        <!-- ══════════════ GRAY PART ══════════════ -->

        <!-- LAUNCHER: gray/white router (shows the splash, decides the mode) -->
        <activity
            android:name=".ledger.JunctionGate"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.App.CabView">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- AppsFlyer OneLink. Host is a per-project placeholder; if the
                 project has no OneLink, gray.oneLinkHost stays "nolink.invalid"
                 and gray.oneLinkVerify=false, and this filter matches nothing
                 harmless in place. -->
            <intent-filter android:autoVerify="${grayOneLinkVerify}">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${grayOneLinkHost}" />
            </intent-filter>
        </activity>

        <activity
            android:name=".deck.CarriageShell"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.App.Stream" />

        <activity
            android:name=".deck.SemaphorePrompt"
            android:exported="false"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.App.CabView" />

        <activity
            android:name=".deck.DeadTrackScreen"
            android:exported="false"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.App.CabView" />

        <service
            android:name=".harness.FcmWhistle"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- ══════════════ NATIVE GAME (Train Sprint) ══════════════ -->
        <!-- Fully-qualified names: the rebrand rewrites relative ".subpkg.Class"
             entries, and the game does not live in a gray sub-package. -->

        <activity
            android:name="com.trainsprint.trainsprintgame.GameActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.TrainSprint.Game" />

        <activity
            android:name="com.trainsprint.trainsprintgame.SettingsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.TrainSprint.Game" />

        <activity
            android:name="com.trainsprint.trainsprintgame.WebActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.TrainSprint" />

    </application>

</manifest>
