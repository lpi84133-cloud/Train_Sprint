# Copy this file to keystore.properties (gitignored) and fill in real values.
# Generate a keystore:
#   keytool -genkeypair -v -keystore keystore/your_app.jks -storetype PKCS12 \
#     -alias your_alias -keyalg RSA -keysize 2048 -validity 9125
storeFile=../keystore/your_app.jks
storePassword=CHANGE_ME
keyAlias=your_alias
keyPassword=CHANGE_ME
